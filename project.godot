[layer_names]

2d_physics/layer_1="WorldStatic"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="PlayerAttack"
2d_physics/layer_5="EnemyAttack"
3d_physics/layer_1="WorldStatic"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="PlayerAttack"
3d_physics/layer_5="EnemyAttack"
3d_physics/layer_6="Pickup"

[physics]

common/physics_ticks_per_second=60
; Gameplay runs on a fixed 60 Hz tick; rendering does not (120 Hz panels, and the
; PerformanceMonitor steps Engine.max_fps down to 30 when a device struggles).
; Interpolation blends body transforms between ticks so the render rate can never
; alias against the sim rate. Purely visual: simulation, determinism and every
; _physics_process gameplay read stay on the fixed tick. The camera rig opts
; itself OUT and reads the interpolated transform manually (see
; CameraRig._configure_interpolation, docs/ARCHITECTURE.md "Timing contract").
common/physics_interpolation=true
; 6 steps/frame is a spiral-of-death brake, NOT extra time: a hitch longer than
; 100 ms silently drops the remainder, so gameplay time can fall behind real time
; while the frame recovers. Pinned by tests/python/test_regress_physics_timing_and_ccd.py.
common/max_physics_steps_per_frame=6
3d/default_gravity=18.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
; HD graphics pass: 2x MSAA + 8x anisotropic filtering + high-quality PCF shadows.
; Mobile renderer is kept (SSAO/SSR remain off on purpose to hold frame time).
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=8
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.09, 0.1, 0.12, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true

[importer_defaults]

; Keep embedded glTF images in Godot's imported scene cache. Extracting them next
; to the source model creates duplicate, untracked PNGs and inflates the asset tree.
scene={
"gltf/embedded_image_handling": 2
}
