; Engine configuration file.
; Last Stand: Arena — a third-person arena survival action game (Godot 4.x, Android).
; This file is the source of truth for project settings, autoloads, input actions,
; and rendering configuration. Keep it consistent with docs/BUILD.md.

config_version=5

[application]

config/name="Last Stand: Arena"
run/main_scene="res://scenes/main/main.tscn"
; Keys here are section-relative: `run/max_fps` under [application] IS the
; application/run/max_fps setting the engine reads (main/main.cpp). Desktop
; stays uncapped (0 = vsync governs); Android caps at 60 so 90/120 Hz panels do
; not burn battery/thermals rendering frames physics never simulates.
; PerformanceMonitor reads the same key as its ceiling and restores it on exit.
run/max_fps=0
run/max_fps.android=60
; The Android Back button is handled in-game (UiRoot routes it: dismiss modal /
; close auxiliary screen / pause / resume / menu / guarded quit) instead of
; quitting outright. SceneTree quits automatically while this is true
; (SceneTree._main_window_go_back), so it must stay false for the notification
; routing to own the button.
config/quit_on_go_back=false
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"
config/version="0.7.0"
boot_splash/bg_color=Color(0.09, 0.1, 0.12, 1)

; Autoload initialization is order-sensitive: each singleton's _ready() runs in
; declaration order, so a singleton may only read another singleton's *data* in
; _ready() when the dependency is declared ABOVE it (all nodes exist by then —
; the engine defers tree insertion — but only earlier _ready()s have run).
; Keep this dependency-first ordering:
;   EventBus      — no dependencies (signals only)
;   DebugErrorHandler — EventBus only (diagnostic tap); persists its own flag in
;     user://debug_mode.cfg (never SaveManager), so it can sit second and capture
;     boot errors from every later singleton
;   SaveManager   — loads from disk in _ready(); reports through EventBus
;   AudioManager  — applies SaveManager settings + EventBus signals at _ready()
;   ContentRegistry — registers loaded + catalogued audio cues into AudioManager
;   GameRoot      — reads persisted best score/wave from SaveManager at _ready()
;   SceneRouter/RunAnalytics/TestHarness — leaf singletons
[autoload]

EventBus="*res://scripts/core/event_bus.gd"
DebugErrorHandler="*res://scripts/debug/debug_error_handler.gd"
SaveManager="*res://scripts/save/save_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
ContentRegistry="*res://scripts/core/content_registry.gd"
GameRoot="*res://scripts/core/game_root.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
RunAnalytics="*res://scripts/core/run_analytics.gd"
TestHarness="*res://scripts/core/test_harness.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
; canvas_items + expand: UI keeps its logical 1280x720 design size while extra
; width/height on tall Android panels (18:9, 19.5:9, 20:9) becomes real layout
; space instead of letterboxing. UiLayout solves overlay geometry per aspect.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 4 = sensor_landscape. The game is designed landscape (see docs/ART_STYLE.md);
; both landscape orientations are honoured so the device can flip either way.
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

; Touch/mouse emulation (main/main.cpp reads these two keys; the old
; `window/handheld/emulate_touchscreen_mouse` line named a setting that does not
; exist in the engine and never did anything). mouse-from-touch MUST stay on:
; every menu/skill/pause Button is a standard Control and only answers touch
; through the emulated mouse events (see TouchScreenButton docs).
; touch-from-mouse stays off: the custom stick/buttons already handle desktop
; mouse natively, and synthesized touch would double-fire them. The joystick's
; _touch_seen filter remains as defense-in-depth.
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

