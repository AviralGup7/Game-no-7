trigger = &"periodic"
radius = 1.4
period = 0.0
damage = 10.0
falloff = &"none"
victim_cooldown = 0.35
scan_interval = 0.05
orbit_radius_fraction = 0.55
orbit_radius_min = 2.0
orbit_radius_max = 6.0
orbit_speed = 1.1
source_id = &"moving_hazard"
marker_color = Color(0.9, 0.2, 0.55, 0.45)
marker_emission = 0.6
marker_emission_armed = 1.2
marker_height = 0.12
tags = Array[StringName]([&"moving", &"patrol"])
