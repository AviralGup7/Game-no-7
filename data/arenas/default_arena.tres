mirror = &"x"

[sub_resource type="Resource" id="hz2"]
script = ExtResource("3_placement")
config = ExtResource("5_cfg")
position = Vector3(0, 0, 6)
mirror = &"z"

[sub_resource type="Resource" id="hz3"]
script = ExtResource("3_placement")
config = ExtResource("5_cfg")
position = Vector3(4, 0, 4)
mirror = &"rot180"

[sub_resource type="Resource" id="hz4"]
script = ExtResource("3_placement")
config = ExtResource("6_cfg")
position = Vector3(3, 0, -3)
mirror = &"rot180"

[sub_resource type="Resource" id="hz5"]
script = ExtResource("3_placement")
