[resource]
script = ExtResource("1_script")
arena_id = &"default_arena"
display_name = "The Foundry Depths"
lore_intro = "The Foundry Depths remember every stand. Yours begins now."
lore_mid = "Blood has soaked these halls for generations."
lore_late = "Three wings, one dungeon. The crowd wants a legend."
scene = ExtResource("2_scene")
enemy_spawn_min_player_distance = 6.0
default_camera_profile = &"default"
background_music_cue = &"music_calm"
allowed_archetypes = Array[StringName]([])
tags = Array[StringName]([&"dungeon", &"classic", &"spikes", &"plates", &"movers", &"fire", &"frost", &"ichor"])
hazard_layout = Array[HazardPlacement]([SubResource("hz1"), SubResource("hz2"), SubResource("hz3"), SubResource("hz4"), SubResource("hz5"), SubResource("hz6"), SubResource("hz7"), SubResource("hz8"), SubResource("hz9"), SubResource("hz10"), SubResource("hz11")])
theme = ExtResource("12_theme")
landmark = ExtResource("13_landmark")
extra_landmarks = Array[ArenaLandmarkPlacement]([SubResource("lp_forge"), SubResource("lp_crystal")])
obstacle_layout = Array[ArenaObstaclePlacement]([SubResource("ob1"), SubResource("ob2"), SubResource("ob3"), SubResource("ob4"), SubResource("ob5"), SubResource("ob6")])
unlock_wave = 1
