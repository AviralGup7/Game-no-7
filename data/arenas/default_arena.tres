[sub_resource type="Resource" id="ob1"]
script = ExtResource("9_obs")
position = Vector3(6.5, 0, 6.5)
half_size_x = 0.8
half_size_y = 1.5
half_size_z = 0.8
mirror = &"both"

[sub_resource type="Resource" id="ob2"]
script = ExtResource("9_obs")
position = Vector3(3.6, 0, 0)
half_size_x = 0.7
half_size_y = 1.15
half_size_z = 0.7
mirror = &"x"

[resource]
script = ExtResource("1_script")
arena_id = &"default_arena"
display_name = "The Pit"
lore_intro = "The Pit remembers every stand. Yours begins now."
lore_mid = "Blood has soaked these stones for generations."
lore_late = "The crowd wants a legend. Don't disappoint them."
scene = ExtResource("2_scene")
enemy_spawn_min_player_distance = 6.0
default_camera_profile = &"default"
background_music_cue = &"music_calm"
allowed_archetypes = Array[StringName]([])
tags = Array[StringName]([&"classic", &"spikes", &"plates", &"movers"])
hazard_layout = Array[HazardPlacement]([SubResource("hz1"), SubResource("hz2"), SubResource("hz3"), SubResource("hz4"), SubResource("hz5"), SubResource("hz6")])
theme = ExtResource("10_theme")
landmark = ExtResource("11_landmark")
obstacle_layout = Array[ArenaObstaclePlacement]([SubResource("ob1"), SubResource("ob2")])
unlock_wave = 1
